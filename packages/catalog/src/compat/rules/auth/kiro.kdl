auth "kiro" {
    name "Kiro"
    env "KIRO_API_KEY"
    // Three-way login (AWS IAM Identity Center device flow, Builder stub,
    // ksk_ API key) is not expressible declaratively; see
    // `loginKiroHook` in `@oh-my-pi/pi-ai/src/registry/oauth/kiro.ts`.
    login "custom" hook="kiro-login"
    refresh hook="kiro-refresh"
    api-key-format "structured"
}
