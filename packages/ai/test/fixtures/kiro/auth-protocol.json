    {
      "name": "browser_pkce_loopback_callback_and_token_exchange",
      "flow": "OAuth 2.0 authorization code with PKCE",
      "provider": "kiro-desktop",
      "steps": [
        {
          "name": "authorization_request",
          "request": {
            "method": "GET",
            "endpoint": "https://auth.{region}.kiro.dev/authorize",
            "query": {
              "response_type": "code",
              "client_id": "<client-id>",
              "redirect_uri": "<loopback-callback-uri>",
              "scope": "<requested-scopes>",
              "state": "<opaque-state>",
              "code_challenge": "<s256-code-challenge>",
              "code_challenge_method": "S256"
            }
          },
          "semantics": [
            "The client creates a loopback callback listener before opening the browser.",
            "The state value is returned unchanged by the callback and must be checked before exchanging the code.",
            "The verifier is retained locally and is never sent to the authorization page."
          ]
        },
        {
          "name": "loopback_callback",
          "request": {
            "method": "GET",
            "endpoint": "<loopback-callback-uri>",
            "query": {
              "code": "<authorization-code>",
              "state": "<opaque-state>"
            }
          },
          "response": {
            "status": 200,
            "fields": {
              "code": "<authorization-code>",
              "state": "<opaque-state>"
            }
          }
        },
        {
          "name": "token_exchange",
          "request": {
            "method": "POST",
            "endpoint": "https://auth.{region}.kiro.dev/oauth/token",
            "headers": {
              "content-type": "application/x-www-form-urlencoded"
            },
            "formFields": {
              "grant_type": "authorization_code",
              "code": "<authorization-code>",
              "redirect_uri": "<loopback-callback-uri>",
              "client_id": "<client-id>",
              "code_verifier": "<pkce-verifier>"
            }
          },
          "response": {
            "status": 200,
            "fields": {
              "accessToken": "<access-token>",
              "refreshToken": "<refresh-token>",
              "expiresIn": "<positive-seconds>",
              "tokenType": "Bearer"
            }
          }
        }
      ]
    },
